    "\n",
    "# ==========================================\n",
    "# 9. PLOT 4: NON-CUMULATIVE TIME COURSE + PAIRED T-TESTS (NaN-aware)\n",
    "# ==========================================\n",
    "fig4, axes4 = plt.subplots(2, len(ESTROUS_ORDER), figsize=(14, 10), sharex=True)\n",
    "\n",
    "cumulative_cols = [col for col in dynamic_time_labels if col.startswith('0-')]\n",
    "def get_min_from_label(label):\n",
    "    return int(label.split('-')[1].replace('min', ''))\n",
    "cumulative_cols.sort(key=get_min_from_label)\n",
    "\n",
    "discrete_map = []\n",
    "for i, cum_col in enumerate(cumulative_cols):\n",
    "    current_min = get_min_from_label(cum_col)\n",
    "    if i == 0:\n",
    "        prev_min, prev_col, label = 0, None, f\"0-{current_min} min\"\n",
    "    else:\n",
    "        prev_min = get_min_from_label(cumulative_cols[i-1])\n",
    "        prev_col = cumulative_cols[i-1]\n",
    "        label = f\"{prev_min}-{current_min} min\"\n",
    "    discrete_map.append({'label': label, 'curr_col': cum_col, 'prev_col': prev_col, 'minute': current_min})\n",
    "\n",
    "ordered_labels = [item['label'] for item in discrete_map]\n",
    "\n",
    "def get_discrete_value(row: pd.Series, prefix: str, curr_col: str, prev_col: Optional[str], alt_prefix: Optional[str] = None) -> float:\n",
    "    \"\"\"Calculate discrete (non-cumulative) value, preserving NaNs.\"\"\"\n",
    "    def get_val(p, c):\n",
    "        if c is None:\n",
    "            return np.nan\n",
    "        full = f\"{p}_{c}\" if c != 'pre' else f\"{p}_pre\"\n",
    "        return get_safe_value(row, full)\n",
    "    \n",
    "    curr = get_val(prefix, curr_col)\n",
    "    if alt_prefix:\n",
    "        alt_curr = get_val(alt_prefix, curr_col)\n",
    "        if not pd.isna(alt_curr):\n",
    "            curr = curr + alt_curr if not pd.isna(curr) else alt_curr\n",
    "    \n",
    "    if prev_col:\n",
    "        prev = get_val(prefix, prev_col)\n",
    "        if alt_prefix:\n",
    "            alt_prev = get_val(alt_prefix, prev_col)\n",
    "            if not pd.isna(alt_prev):\n",
    "                prev = prev + alt_prev if not pd.isna(prev) else alt_prev\n",
    "        else:\n",
    "            prev = prev if prev_col else 0\n",
    "    else:\n",
    "        prev = 0\n",
    "    \n",
    "    # Return NaN if either value is missing, otherwise compute difference\n",
    "    if pd.isna(curr) or pd.isna(prev):\n",
    "        return np.nan\n",
    "    return max(0, curr - prev)\n",
    "\n",
    "for row_idx, (metric_name, d_col1, d_col2, s_col1, s_col2, ylabel) in enumerate([\n",
    "    ('Chamber', 'Di', 'Do', 'Si', 'So', 'Chamber Time [seconds]'),\n",
    "    ('Sniffing', 'Di', None, 'Si', None, 'Sniffing Time [seconds]')\n",
    "]):\n",
    "    for col_idx, (estr_val, estr_title) in enumerate(ESTROUS_LABELS.items()):\n",
    "        ax = axes4[row_idx, col_idx]\n",
    "        mask = df['Estrous'] == estr_val\n",
    "        df_subset = df[mask]\n",
    "        \n",
    "        plot_data = []\n",
    "        pval_by_idx = {}\n",
    "        \n",
    "        for item_idx, item in enumerate(discrete_map):\n",
    "            D_vals, S_vals = [], []\n",
    "            for _, row in df_subset.iterrows():\n",
    "                d_val = get_discrete_value(row, d_col1, item['curr_col'], item['prev_col'], d_col2)\n",
    "                s_val = get_discrete_value(row, s_col1, item['curr_col'], item['prev_col'], s_col2)\n",
    "                D_vals.append(d_val)\n",
    "                S_vals.append(s_val)\n",
    "            \n",
    "            D_arr, S_arr = np.array(D_vals), np.array(S_vals)\n",
    "            \n",
    "            # Paired t-test with NaN handling\n",
    "            D_clean = pd.Series(D_arr).dropna()\n",
    "            S_clean = pd.Series(S_arr).dropna()\n",
    "            common_idx = D_clean.index.intersection(S_clean.index)\n",
    "            \n",
    "            if len(common_idx) > 1:\n",
    "                t_stat, p_val = stats.ttest_rel(D_clean.loc[common_idx], S_clean.loc[common_idx])\n",
    "                pval_by_idx[item_idx] = p_val\n",
    "            else:\n",
    "                pval_by_idx[item_idx] = np.nan\n",
    "            \n",
    "            for exp_id, d_val, s_val in zip(df_subset['Exp'], D_arr, S_arr):\n",
    "                plot_data.append({'Exp': exp_id, 'Time': item['label'], 'D': d_val, 'S': s_val})\n",
    "        \n",
    "        tc_df = pd.DataFrame(plot_data)\n",
    "        try:\n",
    "            tc_df['Time'] = pd.Categorical(tc_df['Time'], categories=ordered_labels, ordered=True)\n",
    "        except:\n",
    "            continue\n",
    "        x_pos = np.arange(len(ordered_labels))\n",
    "        \n",
    "        # Calculate means/SEMs\n",
    "        d_means = [tc_df[tc_df['Time']==tp]['D'].dropna().mean() if len(tc_df[tc_df['Time']==tp]['D'].dropna()) > 0 else np.nan for tp in ordered_labels]\n",
    "        d_sems = [sem(tc_df[tc_df['Time']==tp]['D'].dropna()) for tp in ordered_labels]\n",
    "        s_means = [tc_df[tc_df['Time']==tp]['S'].dropna().mean() if len(tc_df[tc_df['Time']==tp]['S'].dropna()) > 0 else np.nan for tp in ordered_labels]\n",
    "        s_sems = [sem(tc_df[tc_df['Time']==tp]['S'].dropna()) for tp in ordered_labels]\n",
    "        \n",
    "        # Plot with NaN handling\n",
    "        valid_d = [(i, m) for i, m in enumerate(d_means) if not np.isnan(m)]\n",
    "        valid_s = [(i, m) for i, m in enumerate(s_means) if not np.isnan(m)]\n",
    "        \n",
    "        if valid_d:\n",
    "            x_d, y_d = zip(*valid_d)\n",
    "            ax.plot(x_d, y_d, color='#2E86AB', linewidth=2.5, marker='o', markersize=6, label='D time', zorder=3)\n",
    "            y_d_err = [(d_means[i] - d_sems[i], d_means[i] + d_sems[i]) for i in x_d if not np.isnan(d_sems[i])]\n",
    "            if y_d_err:\n",
    "                low, high = zip(*y_d_err)\n",
    "                ax.fill_between(x_d, low, high, color='#2E86AB', alpha=0.2, zorder=2)\n",
    "        \n",
    "        if valid_s:\n",
    "            x_s, y_s = zip(*valid_s)\n",
    "            ax.plot(x_s, y_s, color='#E94F37', linewidth=2.5, marker='s', markersize=6, label='S time', zorder=3)\n",
    "            y_s_err = [(s_means[i] - s_sems[i], s_means[i] + s_sems[i]) for i in x_s if not np.isnan(s_sems[i])]\n",
    "            if y_s_err:\n",
    "                low, high = zip(*y_s_err)\n",
    "                ax.fill_between(x_s, low, high, color='#E94F37', alpha=0.2, zorder=2)\n",
    "        \n",
    "        # Individual lines with segment splitting (no connecting across NaNs)\n",
    "        exps_complete = tc_df.groupby('Exp').filter(lambda g: len(g)==len(ordered_labels))['Exp'].unique()\n",
    "        for exp in exps_complete:\n",
    "            exp_data = tc_df[tc_df['Exp']==exp].sort_values('Time')\n",
    "            \n",
    "            for col, color in [('D', '#2E86AB'), ('S', '#E94F37')]:\n",
    "                vals = exp_data[col].values\n",
    "                valid_mask = ~np.isnan(vals)\n",
    "                if np.any(valid_mask):\n",
    "                    segments = []\n",
    "                    start = None\n",
    "                    for i, valid in enumerate(valid_mask):\n",
    "                        if valid and start is None:\n",
    "                            start = i\n",
    "                        elif not valid and start is not None:\n",
    "                            segments.append((start, i))\n",
    "                            start = None\n",
    "                    if start is not None:\n",
    "                        segments.append((start, len(valid_mask)))\n",
    "                    \n",
    "                    for seg_start, seg_end in segments:\n",
    "                        x_seg = x_pos[seg_start:seg_end]\n",
    "                        y_seg = vals[seg_start:seg_end]\n",
    "                        ax.plot(x_seg, y_seg, color=color, linewidth=0.6, alpha=0.3, zorder=1)\n",
    "        \n",
    "        # Annotate with RAW p-values\n",
    "        for i, item in enumerate(discrete_map):\n",
    "            p_val = pval_by_idx.get(i)\n",
    "            if p_val is not None and not np.isnan(p_val) and not np.isnan(d_means[i]) and not np.isnan(s_means[i]):\n",
    "                y_max = max(d_means[i] + d_sems[i], s_means[i] + s_sems[i])\n",
    "                if not np.isnan(y_max):\n",
    "                    add_pval_annotation(ax, i-0.2, i+0.2, y_max, p_val)\n",
    "        \n",
    "        # 🔹 Highlight missing data regions\n",
    "        if any('30' in lbl and '40' in ordered_labels[idx+1] if idx+1 < len(ordered_labels) else False \n",
    "               for idx, lbl in enumerate(ordered_labels)):\n",
    "            # Find indices for 30-40 min region\n",
    "            for idx, lbl in enumerate(ordered_labels):\n",
    "                if '30-40' in lbl or ('25-30' in lbl and idx+1 < len(ordered_labels) and '40' in ordered_labels[idx+1]):\n",
    "                    ax.axvspan(idx - 0.5, idx + 0.5, color='lightgray', alpha=0.15)\n",
    "                    break\n",
    "        \n",
    "        ax.set_title(f'{estr_title} (n={len(exps_complete)})', fontsize=18, fontweight='bold', pad=10)\n",
    "        ax.set_xticks(x_pos)\n",
    "        ax.set_xticklabels(ordered_labels, fontsize=14, rotation=45, ha='right')\n",
    "        ax.grid(axis='y', alpha=0.35, linestyle='--', linewidth=0.5)\n",
