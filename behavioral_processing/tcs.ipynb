    "# ==========================================\n",
    "# 8. PLOT 2: CUMULATIVE TIME COURSE \n",
    "# ==========================================\n",
    "time_points_tc = dynamic_time_labels\n",
    "\n",
    "fig2, axes2 = plt.subplots(2, len(ESTROUS_ORDER), figsize=(14, 10))\n",
    "\n",
    "for row_idx, (metric_name, d_col1, d_col2, s_col1, s_col2, ylabel) in enumerate([\n",
    "    ('Chamber', 'Di', 'Do', 'Si', 'So', 'Chamber Time [seconds]'),\n",
    "    ('Sniffing', 'Di', None, 'Si', None, 'Sniffing Time [seconds]')\n",
    "]):\n",
    "    for col_idx, (estr_val, estr_title) in enumerate(ESTROUS_LABELS.items()):\n",
    "        ax = axes2[row_idx, col_idx]\n",
    "\n",
    "        plot_data = []\n",
    "        for _, row in df.iterrows():\n",
    "            if row['Estrous'] == estr_val:\n",
    "                exp = row['Exp']\n",
    "                for tp in time_points_tc:\n",
    "                    d_c1 = f\"{d_col1}_{tp}\" if tp != 'pre' else f\"{d_col1}_pre\"\n",
    "                    s_c1 = f\"{s_col1}_{tp}\" if tp != 'pre' else f\"{s_col1}_pre\"\n",
    "                    \n",
    "                    # ✅ Use get_safe_value to preserve NaNs\n",
    "                    d_val = get_safe_value(row, d_c1)\n",
    "                    if d_col2:\n",
    "                        d_c2 = f\"{d_col2}_{tp}\" if tp != 'pre' else f\"{d_col2}_pre\"\n",
    "                        alt_val = get_safe_value(row, d_c2)\n",
    "                        if not pd.isna(alt_val):\n",
    "                            d_val = d_val + alt_val if not pd.isna(d_val) else alt_val\n",
    "                        \n",
    "                    s_val = get_safe_value(row, s_c1)\n",
    "                    if s_col2:\n",
    "                        s_c2 = f\"{s_col2}_{tp}\" if tp != 'pre' else f\"{s_col2}_pre\"\n",
    "                        alt_val = get_safe_value(row, s_c2)\n",
    "                        if not pd.isna(alt_val):\n",
    "                            s_val = s_val + alt_val if not pd.isna(s_val) else alt_val\n",
    "                        \n",
    "                    plot_data.append({'Exp': exp, 'Time': tp, 'D': d_val, 'S': s_val})\n",
    "        \n",
    "        tc_df = pd.DataFrame(plot_data)\n",
    "        try:\n",
    "            tc_df['Time'] = pd.Categorical(tc_df['Time'], categories=time_points_tc, ordered=True)\n",
    "        except:\n",
    "            continue\n",
    "        \n",
    "        x_pos = np.arange(len(time_points_tc))\n",
    "        \n",
    "        # Calculate means/SEMs with NaN handling\n",
    "        d_means, d_sems, s_means, s_sems = [], [], [], []\n",
    "        for tp in time_points_tc:\n",
    "            d_subset = tc_df[tc_df['Time']==tp]['D'].dropna()\n",
    "            s_subset = tc_df[tc_df['Time']==tp]['S'].dropna()\n",
    "            d_means.append(d_subset.mean() if len(d_subset) > 0 else np.nan)\n",
    "            d_sems.append(sem(d_subset))\n",
    "            s_means.append(s_subset.mean() if len(s_subset) > 0 else np.nan)\n",
    "            s_sems.append(sem(s_subset))\n",
    "        \n",
    "        # Plot means with NaN handling (skip plotting if mean is NaN)\n",
    "        try:\n",
    "            valid_d = [(i, m) for i, m in enumerate(d_means) if not np.isnan(m)]\n",
    "            valid_s = [(i, m) for i, m in enumerate(s_means) if not np.isnan(m)]\n",
    "            \n",
    "            if valid_d:\n",
    "                x_d, y_d = zip(*valid_d)\n",
    "                ax.plot(x_d, y_d, color='#2E86AB', linewidth=2.5, marker='o', markersize=6, label='D time', zorder=3)\n",
    "                # Fill between with SEM (only for valid points)\n",
    "                y_d_err_low = [d_means[i] - d_sems[i] for i in x_d if not np.isnan(d_sems[i])]\n",
    "                y_d_err_high = [d_means[i] + d_sems[i] for i in x_d if not np.isnan(d_sems[i])]\n",
    "                if y_d_err_low and y_d_err_high:\n",
    "                    ax.fill_between(x_d, y_d_err_low, y_d_err_high, color='#2E86AB', alpha=0.2, zorder=2)\n",
    "            \n",
    "            if valid_s:\n",
    "                x_s, y_s = zip(*valid_s)\n",
    "                ax.plot(x_s, y_s, color='#E94F37', linewidth=2.5, marker='s', markersize=6, label='S time', zorder=3)\n",
    "                y_s_err_low = [s_means[i] - s_sems[i] for i in x_s if not np.isnan(s_sems[i])]\n",
    "                y_s_err_high = [s_means[i] + s_sems[i] for i in x_s if not np.isnan(s_sems[i])]\n",
    "                if y_s_err_low and y_s_err_high:\n",
    "                    ax.fill_between(x_s, y_s_err_low, y_s_err_high, color='#E94F37', alpha=0.2, zorder=2)\n",
    "        except:\n",
    "            continue\n",
    "            \n",
    "        # Individual lines: ✅ Don't connect across NaNs\n",
    "        exps_complete = tc_df.groupby('Exp').filter(lambda g: len(g)==len(time_points_tc))['Exp'].unique()\n",
    "        for exp in exps_complete:\n",
    "            exp_data = tc_df[tc_df['Exp']==exp].sort_values('Time')\n",
    "            \n",
    "            # Split D values into contiguous non-NaN segments\n",
    "            d_vals = exp_data['D'].values\n",
    "            valid_mask = ~np.isnan(d_vals)\n",
    "            if np.any(valid_mask):\n",
    "                # Find contiguous segments\n",
    "                segments = []\n",
    "                start = None\n",
    "                for i, valid in enumerate(valid_mask):\n",
    "                    if valid and start is None:\n",
    "                        start = i\n",
    "                    elif not valid and start is not None:\n",
    "                        segments.append((start, i))\n",
    "                        start = None\n",
    "                if start is not None:\n",
    "                    segments.append((start, len(valid_mask)))\n",
    "                \n",
    "                for seg_start, seg_end in segments:\n",
    "                    x_seg = x_pos[seg_start:seg_end]\n",
    "                    y_seg = d_vals[seg_start:seg_end]\n",
    "                    ax.plot(x_seg, y_seg, color='#2E86AB', linewidth=0.6, alpha=0.3, zorder=1)\n",
    "            \n",
    "            # Same for S values\n",
    "            s_vals = exp_data['S'].values\n",
    "            valid_mask = ~np.isnan(s_vals)\n",
    "            if np.any(valid_mask):\n",
    "                segments = []\n",
    "                start = None\n",
    "                for i, valid in enumerate(valid_mask):\n",
    "                    if valid and start is None:\n",
    "                        start = i\n",
    "                    elif not valid and start is not None:\n",
    "                        segments.append((start, i))\n",
    "                        start = None\n",
    "                if start is not None:\n",
    "                    segments.append((start, len(valid_mask)))\n",
    "                \n",
    "                for seg_start, seg_end in segments:\n",
    "                    x_seg = x_pos[seg_start:seg_end]\n",
    "                    y_seg = s_vals[seg_start:seg_end]\n",
    "                    ax.plot(x_seg, y_seg, color='#E94F37', linewidth=0.6, alpha=0.3, zorder=1)\n",
    "        \n",
    "        # P-value annotations (only for time points with valid paired data)\n",
    "        for i, tp in enumerate(time_points_tc):\n",
    "            D_vals = tc_df[tc_df['Time']==tp]['D'].dropna()\n",
    "            S_vals = tc_df[tc_df['Time']==tp]['S'].dropna()\n",
    "            common_idx = D_vals.index.intersection(S_vals.index)\n",
    "            \n",
    "            if len(common_idx) > 1 and not np.isnan(d_means[i]) and not np.isnan(s_means[i]):\n",
    "                t_stat, p_val = stats.ttest_rel(D_vals.loc[common_idx], S_vals.loc[common_idx])\n",
    "                y_max = max(d_means[i] + d_sems[i], s_means[i] + s_sems[i])\n",
