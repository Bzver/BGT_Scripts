    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy import stats\n",
    "import re\n",
    "from typing import Literal, Optional\n",
    "import warnings\n",
    "\n",
    "warnings.filterwarnings('ignore', category=RuntimeWarning)\n",
    "\n",
    "SAMPLE_DATA_FILE = r\"D:\\\Data\\TCS\\TCdata.xlsx\"\n",
    "CUSTOM_BINS_LENGTH = 5\n",
    "END_MIN = 10\n",
    "METRIC_PREFIXES = ['Di', 'Do', 'Si', 'So']\n",
    "CUSTOM_BINS_MINUTES = list(range(CUSTOM_BINS_LENGTH, END_MIN+CUSTOM_BINS_LENGTH, CUSTOM_BINS_LENGTH))\n",
    "\n",
    "SE_or_VG: Literal[\"SE\", \"VG\", \"Both\", \"OVX\"] = \"VG\"\n",
    "DISABLE_ALL_FILTERS = False\n",
    "PRE_BIAS_THRESH = 0.5\n",
    "USE_CYCLE = True\n",
    "\n",
    "# ==========================================\n",
    "# 0. SETUP: GRADED ESTROUS DEFINITIONS\n",
    "# ==========================================\n",
    "ESTROUS_ORDER = [0, 1]\n",
    "ESTROUS_LABELS = {\n",
    "    0: 'Non-E',  1: 'Estrous'\n",
    "}\n",
    "ESTROUS_COLORS = {\n",
    "    0: '#636363', 1: '#ffffff'\n",
    "}\n",
    "\n",
    "OVX_LABELS = {\n",
    "    0: 'OVX',  1: 'OVX+EB/P4'\n",
    "}\n",
    "\n",
    "CYCLE_ORDER = [\"P\", \"E\", \"M\", \"D\"]\n",
    "CYCLE_LABELS = {\n",
    "    \"P\": 'proestrus',  \"E\": 'estrus', \"M\": 'metestrus', \"D\": 'diestrus'\n",
    "}\n",
    "CYCLE_COLORS = {\n",
    "    \"P\": \"#FFF351\",  \"E\": \"#FA1313\", \"M\": \"#65EE75\", \"D\": \"#0C9DDB\"\n",
    "}\n",
    "\n",
    "# ==========================================\n",
    "# 1. LOAD & FILTER DATA\n",
    "# ==========================================\n",
    "\n",
    "sheet_active = 'OVX-total' if SE_or_VG == \"OVX\" else 'wt-total'\n",
    "\n",
    "df = pd.read_excel(SAMPLE_DATA_FILE, sheet_name=sheet_active)\n",
    "\n",
    "if \"Cycle\" in df.columns and USE_CYCLE and SE_or_VG != \"OVX\":\n",
    "    ESTROUS_ORDER = CYCLE_ORDER\n",
    "    ESTROUS_LABELS = CYCLE_LABELS\n",
    "    ESTROUS_COLORS = CYCLE_COLORS\n",
    "    df['Estrous'] = pd.Categorical(df['Cycle'], categories=ESTROUS_ORDER, ordered=True)\n",
    "else:\n",
    "    if SE_or_VG == \"OVX\":\n",
    "        ESTROUS_LABELS = OVX_LABELS\n",
    "    df['Estrous'] = pd.Categorical(df['Estrous'], categories=ESTROUS_ORDER, ordered=True)\n",
    "    df['Estrous'] = df['Cycle'].map(lambda x: 1 if str(x) in [\"P\", \"E\"] else 0)\n",
    "\n",
    "if not DISABLE_ALL_FILTERS:\n",
    "    if SE_or_VG == \"SE\":\n",
    "        df = df[df[\"Virgin\"] != 1]\n",
    "    elif SE_or_VG == \"VG\":\n",
    "        df = df[df[\"Virgin\"] == 1]\n",
    "\n",
    "    df['PB'] = (df['Di_pre'] + df['Do_pre'] - df['Si_pre'] - df['So_pre'])/(df['Di_pre'] + df['Do_pre'] + df['Si_pre'] + df['So_pre'])\n",
    "    df = df[abs(df['PB']) <= PRE_BIAS_THRESH]\n",
    "\n",
    "# df['Estrous'] = 1\n",
    "\n",
    "# ==========================================\n",
    "# 2. HELPER: DATA COMPLETENESS CHECK\n",
    "# ==========================================\n",
    "def check_data_completeness(df: pd.DataFrame, prefix: str, time_labels: list) -> dict:\n",
    "    \"\"\"\n",
    "    Report % of missing data per time bin for a given prefix.\n",
    "    Returns dict with completeness stats for transparency.\n",
    "    \"\"\"\n",
    "    completeness = {}\n",
    "    for tp in time_labels:\n",
    "        col = f\"{prefix}_{tp}\" if tp != 'pre' else f\"{prefix}_pre\"\n",
    "        if col in df.columns:\n",
    "            missing_pct = df[col].isna().mean() * 100\n",
    "            valid_pct = 100 - missing_pct\n",
    "            completeness[tp] = {'missing_pct': missing_pct, 'valid_pct': valid_pct}\n",
    "        else:\n",
    "            completeness[tp] = {'missing_pct': 100, 'valid_pct': 0}\n",
    "    return completeness\n",
    "\n",
    "# ==========================================\n",
    "# 3. DYNAMIC BIN CALCULATION (NaN-aware)\n",
    "# ==========================================\n",
    "def get_time_columns(df: pd.DataFrame, prefix: str) -> dict:\n",
    "    \"\"\"Identifies all time-point columns for a given prefix.\"\"\"\n",
    "    cols = {}\n",
    "    pre_col = f\"{prefix}_pre\"\n",
    "    sum_col = f\"{prefix}_Sum\"\n",
    "    \n",
    "    if pre_col in df.columns:\n",
    "        cols['pre'] = pre_col\n",
    "    if sum_col in df.columns:\n",
    "        cols['sum'] = sum_col\n",
    "\n",
    "    pattern = re.compile(rf\"^{prefix}_(\\d+)min$\")\n",
    "    for col in df.columns:\n",
    "        match = pattern.match(col)\n",
    "        if match:\n",
    "            minute = int(match.group(1))\n",
    "            cols[minute] = col\n",
    "    return cols\n",
    "\n",
    "def calculate_cumulative_bin(df: pd.DataFrame, prefix: str, target_minute: int, \n",
    "                            col_map: dict, min_valid_points: int = 1) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Calculates cumulative sum up to target_minute, preserving NaNs when data is missing.\n",
    "    \n",
    "    Parameters:\n",
    "    -----------\n",
    "    min_valid_points : int\n",
    "        Minimum number of non-NaN values required to compute a result.\n",
    "        If fewer valid points exist, returns NaN for that row.\n",
    "    \"\"\"\n",
    "    relevant_minutes = [m for m in col_map.keys() if isinstance(m, int) and m <= target_minute]\n",
    "    \n",
    "    if not relevant_minutes:\n",
    "        return np.full(len(df), np.nan)\n",
    "        \n",
    "    cols_to_sum = [col_map[m] for m in sorted(relevant_minutes)]\n",
    "    \n",
    "    # Sum with skipna=True, but track valid counts\n",
    "    cumsum = df[cols_to_sum].sum(axis=1, skipna=False)\n",
    "    valid_counts = df[cols_to_sum].notna().sum(axis=1)\n",
    "    \n",
    "    # Return NaN if insufficient valid data points\n",
    "    result = cumsum.where(valid_counts >= min_valid_points, np.nan)\n",
    "    return result.values\n",
    "\n",
    "# Generate dynamic time labels and calculate data\n",
    "dynamic_time_labels = []\n",
    "col_maps = {}\n",
    "\n",
    "for prefix in METRIC_PREFIXES:\n",
    "    col_maps[prefix] = get_time_columns(df, prefix)\n",
    "\n",
    "# Run completeness check before calculations\n",
    "for prefix in METRIC_PREFIXES:\n",
    "    check_data_completeness(df, prefix, [f\"{m}min\" for m in range(1, 41)] + ['pre'])\n",
    "\n",
    "for bin_min in CUSTOM_BINS_MINUTES:\n",
    "    label = f\"0-{bin_min}min\"\n",
    "    dynamic_time_labels.append(label)\n",
    "    \n",
    "    for prefix in METRIC_PREFIXES:\n",
    "        new_col_name = f\"{prefix}_{label}\"\n",
    "        df[new_col_name] = calculate_cumulative_bin(df, prefix, bin_min, col_maps[prefix], min_valid_points=1)\n",
    "\n",
    "        if bin_min == CUSTOM_BINS_MINUTES[-1] and 'sum' in col_maps[prefix]:\n",
    "            sum_col = col_maps[prefix]['sum']\n",
    "            diff = np.abs(df[new_col_name] - df[sum_col])\n",
    "            df[sum_col] = df[new_col_name]\n",
    "            # Only check non-NaN values\n",
    "            # valid_diff = diff[diff.notna()]\n",
    "            # if len(valid_diff) > 0:\n",
    "            #     assert np.all(valid_diff < 2), f\"Cumulative sum mismatch at {new_col_name}: max diff = {valid_diff.max()}\"\n",
    "\n",
    "# Also add 'pre' to labels if it exists in data\n",
    "if 'pre' in col_maps.get('Di', {}):\n",
    "    dynamic_time_labels.insert(0, 'pre')\n",
    "\n",
    "print(f\"\\nAvailable Dynamic Time Labels: {dynamic_time_labels}\")\n",
    "\n",
    "# ==========================================\n",
    "# 4. HELPER FUNCTIONS (NaN-aware)\n",
    "# ==========================================\n",
    "def sem(x):\n",
    "    \"\"\"Calculate standard error of mean, handling NaNs.\"\"\"\n",
    "    x = np.asarray(x)\n",
    "    x_clean = x[~np.isnan(x)]\n",
    "    return np.std(x_clean, ddof=1) / np.sqrt(len(x_clean)) if len(x_clean) > 1 else np.nan\n",
    "\n",
    "def format_pval(p):\n",
    "    if pd.isna(p):\n",
    "        return \"p=NA\"\n",
    "    stars = \"***\" if p < 0.001 else \"**\" if p < 0.01 else \"*\" if p < 0.05 else \"ns\"\n",
    "    if p >= 0.001:\n",
    "        return f\"{stars}\\n(p={p:.3f})\"\n",
    "    elif p >= 0.0001:\n",
    "        return f\"{stars}\\n(p={p:.4f})\"\n",
    "    else:\n",
    "        return f\"{stars}\\n(p={p:.5f})\"\n",
    "\n",
    "def add_pval_annotation(ax, x1, x2, y_base, p_value, y_offset=0.25, height_level=0):\n",
    "    if pd.isna(p_value):\n",
    "        return\n",
    "    y_top = (y_base + height_level * 0.08) * (1 + y_offset)\n",
    "    label = format_pval(p_value)\n",
    "    ax.text((x1 + x2) / 2, y_top + 0.06, label, \n",
    "            ha='center', va='bottom', fontsize=9, fontweight='bold',\n",
    "            bbox=dict(boxstyle='round,pad=0.3', facecolor='white', edgecolor='gray', alpha=0.9),\n",
    "            zorder=5)\n",
    "\n",
    "def calculate_pi(d_vals, s_vals):\n",
    "    \"\"\"Calculate Preference Index: PI = (D-S)/(D+S), handling NaNs.\"\"\"\n",
    "    pi_vals = []\n",
    "    for d, s in zip(d_vals, s_vals):\n",
    "        if pd.isna(d) or pd.isna(s) or (d + s) == 0:\n",
    "            pi_vals.append(np.nan)\n",
    "        else:\n",
    "            pi_vals.append((d - s) / (d + s))\n",
    "    return np.array(pi_vals)\n",
    "\n",
    "def get_safe_value(row: pd.Series, col_name: str) -> float:\n",
    "    \"\"\"Safely get value from row, returning NaN if column missing or value is missing.\"\"\"\n",
    "    if col_name in row.index:\n",
    "        val = row[col_name]\n",
    "        return val if not pd.isna(val) else np.nan\n",
    "    return np.nan\n",
    "\n",
    "# ==========================================\n",
    "# 5. STATISTICAL TESTING: NaN-aware\n",
    "# ==========================================\n",
    "print(\"\\n=== Welch's t-tests: Chamber (D vs S) by Estrous Level ===\")\n",
    "chamber_pvals = {}\n",
    "for tp in dynamic_time_labels:\n",
    "    for estr_level in ESTROUS_ORDER:\n",
    "        mask = df['Estrous'] == estr_level\n",
    "        if mask.sum() < 2:\n",
    "            continue\n",
    "\n",
    "        di_col = f\"Di_{tp}\" if tp != 'pre' else \"Di_pre\"\n",
    "        do_col = f\"Do_{tp}\" if tp != 'pre' else \"Do_pre\"\n",
    "        si_col = f\"Si_{tp}\" if tp != 'pre' else \"Si_pre\"\n",
    "        so_col = f\"So_{tp}\" if tp != 'pre' else \"So_pre\"\n",
    "\n",
    "        if di_col in df.columns and si_col in df.columns:\n",
    "            D_val = df.loc[mask, di_col].copy()\n",
    "            if do_col in df.columns:\n",
    "                D_val = D_val + df.loc[mask, do_col]\n",
    "            \n",
    "            S_val = df.loc[mask, si_col].copy()\n",
    "            if so_col in df.columns:\n",
    "                S_val = S_val + df.loc[mask, so_col]\n",
    "            \n",
    "            # ✅ Drop NaNs and align indices for paired test\n",
    "            D_clean = D_val.dropna()\n",
    "            S_clean = S_val.dropna()\n",
    "            common_idx = D_clean.index.intersection(S_clean.index)\n",
    "            \n",
    "            if len(common_idx) > 1:\n",
    "                t, p = stats.ttest_rel(D_clean.loc[common_idx], S_clean.loc[common_idx])\n",
    "                key = (tp, 'Chamber', estr_level)\n",
    "                chamber_pvals[key] = p\n",
    "                estr_label = ESTROUS_LABELS.get(estr_level, estr_level)\n",
    "                print(f\"{tp:10s} {estr_label:12s} | t={t:6.3f} | p={p:.4f} {format_pval(p).split()[0]} (n={len(common_idx)})\")\n",
    "\n",
    "print(\"\\n=== Welch's t-tests: Sniffing (Di vs Si) by Estrous Level ===\")\n",
    "inter_pvals = {}\n",
    "for tp in dynamic_time_labels:\n",
    "    for estr_level in ESTROUS_ORDER:\n",
    "        mask = df['Estrous'] == estr_level\n",
    "        if mask.sum() < 2:\n",
    "            continue\n",
    "\n",
    "        di_col = f\"Di_{tp}\" if tp != 'pre' else \"Di_pre\"\n",
    "        si_col = f\"Si_{tp}\" if tp != 'pre' else \"Si_pre\"\n",
    "        \n",
    "        if di_col in df.columns and si_col in df.columns:\n",
    "            D_val = df.loc[mask, di_col].dropna()\n",
    "            S_val = df.loc[mask, si_col].dropna()\n",
    "            common_idx = D_val.index.intersection(S_val.index)\n",
    "            \n",
    "            if len(common_idx) > 1:\n",
    "                t, p = stats.ttest_rel(D_val.loc[common_idx], S_val.loc[common_idx])\n",
    "                key = (tp, 'Sniffing', estr_level)\n",
    "                inter_pvals[key] = p\n",
    "                estr_label = ESTROUS_LABELS.get(estr_level, estr_level)\n",
    "                print(f\"{tp:10s} {estr_label:12s} | t={t:6.3f} | p={p:.4f} {format_pval(p).split()[0]} (n={len(common_idx)})\")\n",
    "\n",
    "# ==========================================\n",
    "# PI STATISTICAL TESTING: One-sample t-test vs 0 (NaN-aware)\n",
    "# ==========================================\n",
    "print(\"\\n=== One-sample t-tests: PI Index vs 0 by Estrous Level ===\")\n",
    "pi_pvals_vs_zero = {}\n",
    "\n",
    "for tp in dynamic_time_labels:\n",
    "    for group_name in ['Chamber', 'Sniffing']:\n",
    "        di_col = f\"Di_{tp}\" if tp != 'pre' else \"Di_pre\"\n",
    "        do_col = f\"Do_{tp}\" if tp != 'pre' else \"Do_pre\"\n",
    "        si_col = f\"Si_{tp}\" if tp != 'pre' else \"Si_pre\"\n",
    "        so_col = f\"So_{tp}\" if tp != 'pre' else \"So_pre\"\n",
    "        \n",
    "        if di_col not in df.columns or si_col not in df.columns:\n",
    "            continue\n",
    "\n",
    "        for estr_level in ESTROUS_ORDER:\n",
    "            mask = df['Estrous'] == estr_level\n",
    "            if mask.sum() < 2:\n",
    "                continue\n",
    "            \n",
    "            if group_name == 'Chamber':\n",
    "                D_data = df.loc[mask, di_col].copy()\n",
    "                if do_col in df.columns:\n",
    "                    D_data = D_data + df.loc[mask, do_col]\n",
    "                S_data = df.loc[mask, si_col].copy()\n",
    "                if so_col in df.columns:\n",
    "                    S_data = S_data + df.loc[mask, so_col]\n",
    "            else:\n",
    "                D_data = df.loc[mask, di_col]\n",
    "                S_data = df.loc[mask, si_col]\n",
    "            \n",
    "            pi_vals = calculate_pi(D_data, S_data)\n",
    "            pi_vals_clean = pi_vals[~np.isnan(pi_vals)]\n",
    "            \n",
    "            if len(pi_vals_clean) > 1:\n",
    "                t_stat, p_val = stats.ttest_1samp(pi_vals_clean, popmean=0)\n",
    "                key = (tp, group_name, estr_level)\n",
    "                pi_pvals_vs_zero[key] = p_val\n",
    "                mean_pi = np.mean(pi_vals_clean)\n",
    "                direction = \"D-pref\" if mean_pi > 0 else \"S-pref\" if mean_pi < 0 else \"neutral\"\n",
    "                estr_label = ESTROUS_LABELS.get(estr_level, estr_level)\n",
    "                print(f\"{tp:10s} {group_name:10s} {estr_label:12s} | Mean PI={mean_pi:.3f} ({direction}) | t={t_stat:6.3f} | p={p_val:.4f} {format_pval(p_val).split()[0]} (n={len(pi_vals_clean)})\")\n",
    "            else:\n",
    "                key = (tp, group_name, estr_level)\n",
    "                pi_pvals_vs_zero[key] = np.nan\n",
    "\n",
